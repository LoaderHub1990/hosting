# ───────── จำเป็น ─────────
# สุ่มยาวๆ อย่างน้อย 32 ตัวอักษร:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TOKEN_SECRET=
# รหัสแอดมิน (ใช้ล็อกอินหน้า /admin และเป็น x-admin-token สำหรับบอท) — ถ้าไม่ตั้งจะใช้ TOKEN_SECRET
ADMIN_SECRET=

# ───────── เว็บ ─────────
BASE_URL=https://128bit.online
PORT=3000
# เชื่ออ่าน IP จาก cf-connecting-ip / x-forwarded-for (ตั้ง 1 ถ้าอยู่หลัง Cloudflare/Proxy — ถ้าเปิดตรงๆ ไม่มี proxy ตั้ง 0)
TRUST_PROXY=1
# โฟลเดอร์เก็บ keys.db.json / analytics.db.json / audit.log (ค่าเริ่มต้น ./data — ถ้าไฟล์เก่าอยู่ที่รากโปรเจกต์จะอ่านจากที่เดิมให้อัตโนมัติ)
DATA_DIR=./data

# ───────── Get Key (Linkvertise 5 ด่าน) ─────────
LV_LINK_1=
LV_LINK_2=
LV_LINK_3=
LV_LINK_4=
LV_LINK_5=
LV_ANTIBYPASS_TOKEN=
MIN_STEP_MS=8000
# จำกัดจำนวนคีย์ชั่วคราวที่ 1 IP รับได้ต่อวัน
MAX_KEYS_PER_IP_PER_DAY=3

# ───────── Admin ล็อกอินด้วย Discord (ไม่บังคับ ถ้าไม่ตั้งจะใช้รหัสแอดมินอย่างเดียว) ─────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord user id ของแอดมิน คั่นด้วย , (เช่น 123,456)
ADMIN_DISCORD_IDS=

# ───────── ไฟล์ premium (ที่เซิร์ฟ /getkey/api/premium) ─────────
PREMIUM_FILE=./private/premium/main.lua

# ───────── Obfuscator (Prometheus) ─────────
# path ของ cli.lua  เช่น /home/container/.prometheus/cli.lua
PROMETHEUS_PATH=
OBF_MAX_BYTES=512000
OBF_MAX_CONCURRENT=2

# ───────── Vercel (หรือรันหลายอินสแตนซ์) ─────────
# เชื่อม Upstash Redis จาก Vercel → Storage → Marketplace → Upstash Redis จะได้ 2 ตัวนี้ให้เองอัตโนมัติ
# (ตั้งเองได้ด้วยชื่อ UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Obfuscator บน Vercel รันไม่ได้ → ชี้ไปบริการที่รัน `npm run obf-service` บน VPS
OBF_REMOTE_URL=
OBF_REMOTE_TOKEN=
# ใช้กับ obf-service เท่านั้น
OBF_SERVICE_PORT=8787
